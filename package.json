{
  "name": "adbdock",
  "version": "0.4.0",
  "description": "A multi-device ADB CLI with optional Metro connection recovery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floydkim/adbdock.git"
  },
  "homepage": "https://github.com/floydkim/adbdock#readme",
  "bugs": {
    "url": "https://github.com/floydkim/adbdock/issues"
  },
  "type": "module",
  "bin": {
    "adbdock": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run check:plugin && npm run typecheck && npm test",
    "check:plugin": "node scripts/plugin.mjs check",
    "version:plugin": "node scripts/plugin.mjs version",
    "test:devices": "npm run build && node scripts/test-devices.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "qrcode-terminal": "0.12.0"
  },
  "license": "MIT",
  "keywords": [
    "adb",
    "android",
    "react-native",
    "metro",
    "cli",
    "macos"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
